generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id
  name               String
  email              String         @unique
  password           String?
  phoneNumber        String?        @unique
  role               UserRole       @default(tenant)
  providerType       ProviderType   @default(HOTEL)
  nationalId         String?        @unique
  emailVerified      Boolean        @default(false)
  image              String?
  status             Status         @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  twoFactorEnabled   Boolean?       @default(false)
  banExpires         DateTime?
  banReason          String?
  banned             Boolean        @default(false)
  kycRejectionReason String?
  kycReviewedAt      DateTime?
  kycStatus          KycStatus      @default(NOT_SUBMITTED)
  kycSubmittedAt     DateTime?
  accounts           Account[]
  bookings           Booking[]      @relation("BookingClient")
  favorites          Favorite[]
  houses             House[]        @relation("HouseOwner")
  kycDocuments       KycDocument[]
  notifications      Notification[]
  reviews            Review[]       @relation("ReviewTenant")
  sessions           Session[]
  twofactors         TwoFactor[]

  @@map("user")
}

model House {
  id                 String             @id @default(cuid())
  name               String
  location           String
  address            String?
  price              Int?
  media              String[]
  ownerId            String
  description        String
  propertyType       String
  subType            String?
  bedrooms           Int
  bathrooms          Int
  metadata           Json               @default("[]")
  status             HouseStatus        @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  verificationStatus VerificationStatus @default(ReviewedByIndanga)
  owner              User               @relation("HouseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  rooms              RoomType[]
  reviews            Review[]
  favorites          Favorite[]

  @@index([ownerId])
  @@map("house")
}
model RoomType {
  id         String   @id @default(cuid())
  houseId    String
  name       String
  price      Int
  totalRooms Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  house      House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([houseId])
  @@map("room_type")
}
model ServiceFee {
  id          String   @id @default(cuid())
  bookingKind String   @unique
  feeType     FeeType  @default(percentage)
  amount      Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_fee")
}

model Booking {
  id            String         @id @default(cuid())
  bookingId     String?
  clientId      String
  houseId       String
  roomTypeId    String?
  roomCount     Int?           @default(1)
  status        BookingStatus  @default(PENDING)
  checkIn       DateTime?
  checkOut      DateTime?
  nights        Int?
  unitPrice     Int?
  serviceFee    Int?           @default(0)
  totalAmount   Int?
  paymentDeadline DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  client        User           @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  house         House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  roomType      RoomType?      @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  notifications Notification[]
  payments      Payment[]

  @@index([clientId])
  @@index([houseId])
  @@index([roomTypeId])
  @@map("booking")
}
model Payment {
  id                   String         @id @default(cuid())
  amount               Decimal        @db.Decimal(12, 2)
  bookingId            String
  status               PaymentStatus  @default(PENDING)
  method               String
  transactionReference String         @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  notifications        Notification[]
  booking              Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payment")
}

model Review {
  id        String   @id @default(cuid())
  houseId   String
  tenantId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  tenant    User     @relation("ReviewTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([houseId])
  @@index([tenantId])
  @@map("review")
}

model Favorite {
  id        String   @id @default(cuid())
  houseId   String
  userId    String
  createdAt DateTime @default(now())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([houseId, userId])
  @@index([userId])
  @@map("favorite")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  bookingId String?
  paymentId String?
  createdAt DateTime         @default(now())
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notification")
}

model KycDocument {
  id        String          @id @default(cuid())
  userId    String
  type      KycDocumentType @default(ID_DOCUMENT)
  url       String
  mimeType  String
  size      Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("kyc_document")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  verified    Boolean? @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

enum UserRole {
  tenant
  landlord
  admin
}

enum ProviderType {
  HOUSE
  HOTEL
  CAR
}

enum Status {
  ACTIVE
  INACTIVE
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  ID_DOCUMENT
}

enum HouseStatus {
  BOOKED
  AVAILABLE
  PENDING
}

enum PaymentStatus {
  PENDING
  FAILED
  COMPLETED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_REMINDER
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  SYSTEM
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  REQUESTED
  AWAITING_PAYMENT
  CONFIRMED
  DECLINED
  EXPIRED
}

enum VerificationStatus {
  ReviewedByIndanga
  VerifiedByIndanga
}

enum FeeType {
  percentage
  fixed
}
