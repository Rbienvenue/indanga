{
  "$schema": "https://swc.rs/schema.json",
  "module": {
    "type": "es6",
    "resolveFully": true
  },
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "baseUrl": "./",
    "transform": {
      "react": {
        "runtime": "automatic"
      }
    }
  },
  "minify": false
}
