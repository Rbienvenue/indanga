{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [{ "include": "payments/assets/*", "outDir": "dist/src" }],
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [".ts", ".tsx"]
      }
    }
  }
}
